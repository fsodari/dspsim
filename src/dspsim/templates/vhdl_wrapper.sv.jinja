// Generated by dspsim: {{comment}}.
// The module {{entity}} has the generics and ports of the entity. It wraps {{module}}, the netlist that GHDL
// synthesized for these values of the generics, which is at the end of this file.
{%- if typedefs %}

// The records of the ports.
package {{entity}}_pkg;
{%- for name, members in typedefs %}

  typedef struct {
{%- for member in members %}
    {{member}};
{%- endfor %}
  } {{name}};
{%- endfor %}

endpackage
{%- endif %}

module {{entity}}
{%- if typedefs %}
  import {{entity}}_pkg::*;
{%- endif %}
{%- if parameters %}
#(
{%- for parameter in parameters %}
    {{parameter}}{{ "," if not loop.last }}
{%- endfor %}
)
{%- endif %}
(
{%- for port in ports %}
    {{port}}{{ "," if not loop.last }}
{%- endfor %}
);
{%- if wires %}

  // Records and arrays are single vectors in the netlist.
{%- for width, name in wires %}
  wire [{{width - 1}}:0] {{name}};
{%- endfor %}
{%- for assign in assigns %}
  {{assign}}
{%- endfor %}
{%- endif %}

  {{module}} impl_ (
{%- for name, expression in connections %}
      .{{name}}({{expression}}){{ "," if not loop.last }}
{%- endfor %}
  );

endmodule

// GHDL writes Verilog, in which the keywords of SystemVerilog are names like any other.
`begin_keywords "1364-2005"
{{netlist}}
`end_keywords
