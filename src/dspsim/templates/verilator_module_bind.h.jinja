#pragma once
#include "{{model.name}}.h"

#include <nanobind/nanobind.h>
#include <nanobind/stl/string.h>
#include <nanobind/stl/vector.h>
#include <nanobind/stl/shared_ptr.h>
#include <nanobind/stl/filesystem.h>
#include <nanobind/stl/function.h>
#include <nanobind/typing.h>

static inline auto bind_{{model.name}}(nanobind::module_ &m)
{
    return nanobind::class_<{{model.name}}, ::dspsim::Module>(m, "{{model.python_name or model.name}}")
        {# .def(nanobind::init<::dspsim::ModuleName>(), nanobind::arg("name")) #}
        .def(nanobind::new_(&::dspsim::create_module<{{model.name}}>))
        {%-for param in model.parameters.values()%}
        .def_ro_static("{{param.name}}", &{{model.name}}::{{param.name}})
        {%-endfor%}
        {%-for port in model.ports.values()%}
        {%-if port.is_struct and model.struct_ports == "value" and port.is_array%}
        // An array of struct ports: an array of PortBase, whose values Python reads as numpy records.
        .def_prop_ro("{{port.name}}", []({{model.name}} &self) { return ::dspsim::port_base_array(self.{{port.name}}); },
            nanobind::keep_alive<0, 1>())
        {%-elif port.is_struct and model.struct_ports == "value"%}
        // A struct port: a RecordPort, whose value Python reads and writes as a numpy record.
        .def_prop_ro("{{port.name}}", []({{model.name}} &self) -> ::dspsim::RecordPortBase & { return self.{{port.name}}; },
            nanobind::rv_policy::reference_internal)
        {%-elif port.is_struct%}
        .def_prop_ro("{{port.name}}", []({{model.name}} &self) -> ::dspsim::{{ "PortStructArray" if port.is_array else "PortStruct" }} & { return self.{{port.name}}; },
            nanobind::rv_policy::reference_internal)
        {%-else%}
        .def_prop_ro("{{port.name}}", []({{model.name}} &self) -> auto & { return ::dspsim::vport_base(self.{{port.name}}); },
            nanobind::rv_policy::reference_internal)
        {%-endif%}
        {%-endfor%}
        .def("open_trace", &{{model.name}}::open_trace,
            nanobind::arg("trace_path"),
            nanobind::arg("levels") = 99,
            nanobind::arg("options") = 0)
        .def("close_trace", &{{model.name}}::close_trace);
}
