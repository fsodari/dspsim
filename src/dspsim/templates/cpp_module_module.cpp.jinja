// dspsim includes
#include <dspsim/dspsim.h>

// nanobind includes
#include <nanobind/nanobind.h>
#include <nanobind/stl/shared_ptr.h>

// Module bindings
#include "{{model.name}}_bind.h"

namespace nb = nanobind;

NB_MODULE(_{{model.build_name}}, m)
{
    m.doc() = "{{model.name}} module";

    // Import dspsim._framework into the current module. Needed for proper type-stubs.
    auto _framework = m.import_("dspsim._framework");

    m.def("_set_global_context_factory", &dspsim::set_global_context_factory, nb::arg("context_factory"));
    m.def("_get_global_context_factory", &dspsim::get_global_context_factory);
    m.def("_reset_global_context_factory", &dspsim::reset_global_context_factory);

    // Bind generated module.
    bind_{{model.name}}(m);
}
