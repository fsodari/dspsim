{%- from "verilator_struct.jinja" import struct_class -%}
#include <dspsim/vmodule/vmodule.h>
#include <dspsim/struct.h>
#include <V{{model.name}}.h>

DSPSIM_VMOD({{model.name}}, V{{model.name}})
{
public:
    // Parameters
    {%-for param in model.parameters.values()%}
    // inline static const {{param.ctype}} {{param.name}} = {{param.cpp_val}};
    inline static const {{param.ctype}} {{param.name}} = {{param.cpp_val}};
    {%-endfor%}

    // Ports
    {%-for port in model.ports.values()%}
    {%-if port.is_struct%}
    {{ struct_class(port) | indent(4) }}
    {{port.vfield_type()}} {{port.name}}{"{{port.name}}", {{port.vport_args}}};
    {%-else%}
    {{port.vmacro}}({{port.name}}, {{port.width}});
    {%-endif%}
    {%-endfor%}

    // {{model.name}} Constructor
    DSPSIM_CTOR_REF({{model.name}})
    {
        // Standard eval func for verilated modules.
        DSPSIM_METHOD(eval)
            ->always("*");  // Default is sensitive to all inputs. Can be changed by generator.
    }

    // Copy the inputs to the model, evaluate it and copy its outputs back: what VModule::eval() does, with
    // the ports written out so that no call is virtual.
    void eval()
    {
        {%-for port in model.ports.values() if port.direction == "input"%}
        ::dspsim::detail::vl_sync({{port.name}});
        {%-endfor%}
        top->eval();
        {%-for port in model.ports.values() if port.direction != "input"%}
        ::dspsim::detail::vl_sync({{port.name}});
        {%-endfor%}
    }

    // Tracing functions. Will raise a warning if tracing is not enabled, but will just do a no-op.
    void dump_trace_impl();
    void open_trace_impl(const std::filesystem::path &trace_path, int levels = 99, int options = 0);
    void close_trace_impl();
};
