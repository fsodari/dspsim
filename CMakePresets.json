{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 0,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default",
            "description": "Configure the project for a standard local Ninja build.",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_FRAMEWORK": "ON",
                "LOG_TRACE": "OFF"
            }
        },
        {
            "name": "cpp_testing",
            "displayName": "C++ Testing",
            "description": "Build only the C++ library and tests.",
            "inherits": "default",
            "cacheVariables": {
                "SKBUILD_PROJECT_NAME": "dspsim",
                "SKBUILD_PROJECT_VERSION": "0.0.0",
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_FRAMEWORK": "OFF",
                "LOG_TRACE": "ON",
                "Python_ROOT_DIR": "${sourceDir}/.venv",
                "CMAKE_PREFIX_PATH": "${sourceDir}/.venv/lib/python3.14/site-packages"
            }
        },
        {
            "name": "py_cmake_testing",
            "displayName": "Python CMake Testing",
            "description": "Test building the python project without using uv/python.",
            "inherits": "cpp_testing",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_FRAMEWORK": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "pyproject",
            "configurePreset": "default",
            "configuration": "Release"
        },
        {
            "name": "cpp_testing",
            "displayName": "C++ Tests",
            "description": "Build the C++ unit test executables defined in tests/cpp.",
            "configurePreset": "cpp_testing",
            "configuration": "Debug",
            "targets": [
                "tests"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "cpp_tests",
            "configurePreset": "cpp_testing",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        }
    ]
}