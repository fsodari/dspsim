@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Python COMPONENTS Interpreter Development.Module Development.SABIModule)
find_dependency(nanobind CONFIG)
# Verilator is only needed for verilated models (verilate()). C++ modules build without it.
find_package(verilator QUIET)

include(${CMAKE_CURRENT_LIST_DIR}/dspsim-core-targets.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/dspsim-utils.cmake)

set_and_check(DSPSIM_CMAKE_DIR "@PACKAGE_INSTALL_CMAKEDIR@")
set_and_check(DSPSIM_LIB_DIR "@PACKAGE_INSTALL_LIBDIR@")
set_and_check(DSPSIM_INCLUDE_DIR "@PACKAGE_INSTALL_INCLUDEDIR@")
set_and_check(DSPSIM_PKG_DIR "${PACKAGE_PREFIX_DIR}/dspsim")
